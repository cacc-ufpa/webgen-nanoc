<!DOCTYPE html>
<html lang="en">
<head>
	<meta charset="utf-8">
	<meta name="viewport" content="width=device-width, initial-scale=1.0">
	<title><%= @item[:title] || "Documentation" %></title>
	<style>
	body {
		font-family: system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
		line-height: 1.6;
		max-width: 800px;
		margin: 0 auto;
		padding: 40px 20px;
		color: #24292e;
		background-color: #ffffff;
	}
	pre, code {
		font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
		background-color: #f6f8fa;
		padding: 0.2em 0.4em;
		border-radius: 6px;
		font-size: 85%;
	}
	pre code {
		padding: 0;
	}
	pre {
		padding: 16px;
		overflow: auto;
	}
	img {
		max-width: 100%;
	}
	<%= File.read('layouts/syntax.css') %>
	</style>
</head>
<body>
	<main>
		<%= yield %>
	</main>
</body>
</html>

