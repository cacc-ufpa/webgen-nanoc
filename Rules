preprocess do
	# If both a static .pdf and a source .typ exist, drop the static .pdf.
	# Then the compiled Typst version takes precedence, avoiding route collisions.
	@items.delete_if do |item|
		if item.identifier.ext == 'pdf'
			typ_identifier = item.identifier.to_s.sub(/\.pdf$/, '.typ')
			@items[typ_identifier] != nil
		end
	end
end

compile '/**/*.md' do
	filter :redcarpet, renderer: RougeHTML, options: { 
		fenced_code_blocks: true,
		autolink: true,
		tables: true 
	}
	filter :rewrite_links
	layout '/default.*'
	write item.identifier + '.html'
end

compile '/**/*.adoc' do
	filter :asciidoctor
	layout '/default.*'
	write item.identifier + '.html'
end

compile '/**/*.typ' do
	filter :typst
	write item.identifier.without_ext + '.pdf'
end

passthrough '/**/*.html'
passthrough '/**/*.css'
passthrough '/**/*.png'
passthrough '/**/*.jpg'
passthrough '/**/*.c'
passthrough '/**/*.h'
passthrough '/**/*.pdf'
passthrough '/**/*.yml'
passthrough '/**/*.svg'
ignore '/**/*.csl'

# Layout routing
layout '/*', :erb

